# Google Gemini API key for AI-powered civic issue classification
GEMINI_API_KEY=your_gemini_api_key_here

# Cryptographic HMAC secret for signing HttpOnly authentication cookies (min 32 bytes hex)
SESSION_SECRET=replace_with_64_char_random_hex_secret

# Server-side initial Administrator account bootstrap (never exposed to frontend)
ADMIN_BOOTSTRAP_EMAIL=admin@civicresolve.gov
ADMIN_BOOTSTRAP_PASSWORD=replace_with_strong_admin_password
ADMIN_BOOTSTRAP_NAME=Municipal Chief Administrator

# Google Firebase Configuration (Public web app credentials)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Google Maps Platform (Maps JavaScript API)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
